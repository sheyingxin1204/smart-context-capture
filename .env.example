# Optional Chrome CDP base URL. Leave blank to use localhost:9222.
SMART_CONTEXT_CDP_URL=http://127.0.0.1:9222

# Optional explicit Figma REST token. Do not commit a real token here.
FIGMA_ACCESS_TOKEN=

# Optional provider proxy override for tests or an internal gateway.
SMART_CONTEXT_FIGMA_API_BASE=https://api.figma.com
